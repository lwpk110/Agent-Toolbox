# Optional HTTP port. Defaults to 3000.
PORT=3000

# Optional key material for the in-memory Vault. Defaults to a random process key.
# TOOLBOX_VAULT_MASTER_KEY=

# HTTP/SSE MCP ingress (distinct from Vault/outbound credentials).
# Unset: generated in the local data directory as mcp-token (mode 0600).
# TOOLBOX_MCP_TOKEN=
# TOOLBOX_BIND_ADDRESS=127.0.0.1
# Explicit --allow-unauthenticated is restricted to loopback binds.

# GitHub sync test boundary. Public HTTPS is the default.
# TOOLBOX_GITHUB_API_URL=https://api.github.com
# Explicitly permit a loopback/LAN fake GitHub (never metadata/link-local).
# TOOLBOX_GITHUB_ALLOW_PRIVATE=false
